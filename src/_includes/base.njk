<!doctype html>
<html lang="ko">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-GYX9V8J9N9"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-GYX9V8J9N9');
  </script>
  <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="blkx4HtS7GSxef8iIM8rVKkyOrPOy7nmxZL5W9Vmno4" />
<meta name="naver-site-verification" content="10c11b0d26f8e302876910085912ddcabb32ac80" />
  <title>{% if title %}{{ title }} | {% endif %}{{ site.name }} {{ site.nameEn }}</title>
  <meta name="description" content="{{ description or site.intro }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.nameEn }}">
  <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}{{ site.nameEn }}">
  <meta property="og:description" content="{{ description or site.intro }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/logo/icon-512.png">
  <meta property="og:locale" content="ko_KR">

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" href="/assets/logo/icon-256.png">
  <link rel="apple-touch-icon" href="/assets/logo/icon-256.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Noto+Sans+KR:wght@400;500;700;900&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">

  {% block schema %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.nameEn }}",
    "alternateName": "{{ site.name }}",
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}/assets/logo/icon-512.png",
    "description": "도단(DODAN LAB SOLUTION)은 대한민국 대전에 위치한 연구용 시약·항체·ELISA 키트·소모품·연구장비 공급업체로, 바이오 시약 벤더(Bio Reagent Vendor)이자 유통업체(Distributor)입니다.",
    "telephone": "{{ site.phone }}",
    "email": "{{ site.email }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.address }}",
      "addressCountry": "KR"
    },
    "knowsAbout": ["연구용 시약", "항체", "ELISA 키트", "실험소모품", "연구장비", "CRO 위탁연구", "Bio Reagent Vendor", "Distributor"]
  }
    }
  }
  </script>
  {% endblock %}
</head>
<body>
  <a class="skip-link" href="#main">본문 바로가기</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <script src="/js/main.js" defer></script>
</body>
</html>
