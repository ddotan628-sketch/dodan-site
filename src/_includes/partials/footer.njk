<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <img class="brand__mark brand__mark--white" src="/assets/logo/symbol-white.png" alt="" width="46" height="25">
      <p class="site-footer__name">{{ site.nameEn }}<span> · {{ site.name }}</span></p>
      <p class="site-footer__tagline">{{ site.tagline }}</p>
    </div>

    <div class="site-footer__info">
      <p>대표 {{ site.ceo }} · 사업자등록번호 {{ site.bizNo }}</p>
      <p>{{ site.address }}</p>
      <p>
        <a href="{{ site.phoneHref }}">{{ site.phone }}</a> ·
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      </p>
    </div>

    <nav class="site-footer__links">
      <a href="/about/">회사소개</a>
      <a href="/makers/">취급분야·메이커</a>
      <a href="/services/">위탁연구서비스</a>
      <a href="/board/deliveries/">납품일지</a>
      <a href="/board/notices/">공지사항</a>
      <a href="/contact/">문의하기</a>
      <a href="/privacy/">개인정보처리방침</a>
      <a href="/en/">English</a>
    </nav>
  </div>
  <div class="wrap site-footer__bottom">
    <p>&copy; {{ currentYear }} {{ site.nameEn }}. All rights reserved.</p>
  </div>
</footer>
